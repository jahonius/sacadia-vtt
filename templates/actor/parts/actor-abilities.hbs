<section class="tab {{tabs.abilities.cssClass}}" data-group="primary" data-tab="abilities">

  <div class="abilities-top">
    <a class="add-ability" data-action="createDoc" data-document-class="Item" data-type="ability">
      <i class="fa-solid fa-plus"></i> {{localize 'TYPES.Item.ability'}}
    </a>
  </div>

  {{!-- Core combat panel: the frequently-referenced live state, grouped as one unit — AP + the
       per-turn counters up top, then limb exhaustion beside the action log, with focus / marks /
       grants appearing only when live. Shared by both actor types (NPC Max AP is editable). --}}
  <div class="combat-panel">
    <div class="cp-top">
      <div class="ap-readout" title="{{localize 'SACADIA.Economy.ApHint'}}">
        <label>{{localize 'SACADIA.Economy.Ap'}}</label>
        {{#if isCharacter}}
        <span class="ap-values"><b>{{system.ap.value}}</b> / {{system.ap.max}}</span>
        {{else}}
        <span class="ap-values"><b>{{system.ap.value}}</b> / <input class="ap-max" type="number" name="system.ap.max" value="{{system.ap.max}}" min="0"/></span>
        {{/if}}
        <a class="reset-turn" data-action="resetTurn" title="{{localize 'SACADIA.Economy.ResetTurn'}}"><i class="fa-solid fa-rotate-left"></i></a>
      </div>

      {{#if classPools.length}}
      {{!-- Class pools ride the AP line as compact resource readouts rather than claiming their own
           band; the row wraps if a multiclass character carries several. --}}
      <div class="cp-pools">
        {{#each classPools as |pool|}}
        <span class="cp-pool" title="{{localize pool.label}}">
          <label>{{localize pool.label}}</label>
          <input type="number" class="ghost pool-cur" name="system.classPools.{{pool.key}}.value" value="{{pool.value}}" min="0"
                 aria-label="{{localize pool.label}}"/>
          <span class="sep">/</span>
          <input type="number" class="ghost pool-max" name="system.classPools.{{pool.key}}.max" value="{{pool.max}}" min="0"
                 aria-label="{{localize pool.label}} max"/>
        </span>
        {{/each}}
      </div>
      {{/if}}

      {{!-- Player-set Cover (book p239): drives self:cover:* ability gating without map geometry. --}}
      <label class="cp-cover" title="{{localize 'SACADIA.Cover.Hint'}}">
        <i class="fa-solid fa-shield-halved"></i>
        <span class="sac-label">{{localize 'SACADIA.Cover.Label'}}</span>
        <select name="system.cover">
          {{selectOptions config.coverStates selected=system.cover localize=true labelAttr="label"}}
        </select>
      </label>

      {{#if combatStrip.hasLive}}
      <div class="cp-counters">
        <span class="cp-counter"><label>{{localize 'SACADIA.Combat.Moved'}}</label><b>{{combatStrip.moved}} {{localize 'SACADIA.Range.Feet'}}</b></span>
        <span class="cp-counter"><label>{{localize 'SACADIA.Combat.ConsecutiveHits'}}</label><b>&times;{{combatStrip.consecutiveHits}}</b></span>
        <span class="cp-counter"><label>{{localize 'SACADIA.Combat.Attacks'}}</label><b>{{combatStrip.attacks}}</b></span>
      </div>
      {{/if}}
    </div>

    <div class="cp-grid">
      <div class="cp-block">
        <span class="sac-label">{{localize 'SACADIA.Combat.Exhaustion'}}</span>
        <div class="limb-grid">
          {{#each combatStrip.exhaustion as |slot|}}
          <label class="limb {{#if slot.spent}}spent{{/if}}" title="{{localize slot.label}}">
            <input type="checkbox" name="system.exhaustion.{{slot.key}}" {{checked slot.spent}}/>
            {{#if slot.icon}}<i class="{{slot.icon}}"></i>{{/if}}
            <span>{{localize slot.label}}</span>
          </label>
          {{/each}}
        </div>
      </div>

      <div class="cp-block cp-log">
        <span class="sac-label">{{localize 'SACADIA.Economy.ActionsUsed'}}</span>
        <ol class="log-list">
          {{#each system.actionLog as |entry idx|}}
          <li class="log-entry">
            <span class="log-label">{{entry.label}}</span>
            <span class="log-ap">{{entry.ap}}<i class="fa-solid fa-bolt"></i></span>
            <a data-action="undoAction" data-index="{{idx}}" title="{{localize 'SACADIA.Economy.Undo'}}"><i class="fa-solid fa-arrow-rotate-left"></i></a>
          </li>
          {{else}}
          <li class="log-empty">{{localize 'SACADIA.Economy.NoActions'}}</li>
          {{/each}}
        </ol>
      </div>
    </div>

    {{#if combatStrip.hasFocus}}
    <div class="cp-block cp-live">
      <span class="sac-label">{{localize 'SACADIA.Combat.Focus'}}</span>
      {{#each combatStrip.focus as |f|}}
      <div class="cs-line"><span class="cs-name">{{f.name}}</span><span class="sac-streak">{{#each f.bars}}<i></i>{{/each}}</span><span class="cs-detail">{{f.rounds}}</span></div>
      {{/each}}
      {{#each combatStrip.marks as |m|}}
      <div class="cs-line"><span class="cs-name">{{m.label}}</span><span class="cs-detail">&rarr; {{m.names}}</span></div>
      {{/each}}
    </div>
    {{/if}}

  </div>

  {{!-- Secondary combat aids, each in its own box: a Hulinari's form, Slightly Cracked's saved dice, and the Basic
       Actions palette. --}}
  <div class="combat-aux">
    {{#if isHulinari}}
    <div class="aux-group hulinari-form-group" title="{{localize 'SACADIA.HulinariForm.Hint'}}">
      <span class="sac-label">{{localize 'SACADIA.HulinariForm.Label'}}</span>
      <select name="system.professionResources.hulinari.form">
        {{selectOptions config.hulinariForms selected=system.professionResources.hulinari.form localize=true blank=""}}
      </select>
    </div>
    {{/if}}
    {{#if crackedRolls}}
    <div class="aux-group cracked-group" title="{{localize 'SACADIA.Cracked.Hint'}}">
      <span class="sac-label">{{localize 'SACADIA.Cracked.Label'}}</span>
      <div class="cracked-rolls">{{#each crackedRolls as |v|}}<span class="cracked-die">{{v}}</span>{{/each}}</div>
    </div>
    {{/if}}
    {{!-- The palette in its groups: movement, offense, utility. Nearly all cost 1 AP, so only the Boosts say so; each
         chip's tooltip says what it does. --}}
    <div class="aux-group basic-actions-group">
      <div class="ba-head">
        <span class="sac-label">{{localize 'SACADIA.Economy.BasicActions'}}</span>
        <span class="ba-note"><i class="fa-solid fa-bolt"></i> {{localize 'SACADIA.BasicAction.ApNote'}}</span>
      </div>
      {{#each basicActionGroups as |group|}}
      <div class="ba-row" data-kind="{{group.kind}}">
        <span class="ba-kind">{{localize group.label}}</span>
        <div class="basic-actions">
          {{#each group.actions as |a|}}
          <a class="basic-action" data-action="logBasicAction" data-basic="{{a.key}}" data-tooltip-html="{{a.tip}}" data-tooltip-direction="UP">{{localize a.label}}{{#if a.boost}} <small class="boost">{{localize 'SACADIA.BasicAction.Boost'}}</small>{{/if}}</a>
          {{/each}}
        </div>
      </div>
      {{/each}}
    </div>
  </div>

  {{!-- What rides on the next attack: armed Boosts (click to disarm) and buffs banked for it (Critical Strike …). --}}
  {{#if (or armedBoosts.length nextAttack.length)}}
  <div class="boost-tray" data-tooltip="{{localize 'SACADIA.Combat.NextAttackHint'}}">
    <span class="boost-tray-label"><i class="fa-solid fa-bolt"></i> {{localize 'SACADIA.Combat.NextAttack'}}</span>
    {{#each armedBoosts as |boost|}}
    <a class="sac-chip armed boost-chip" data-action="toggleBoost" data-item-id="{{boost.id}}"
       title="{{localize 'SACADIA.Boost.Disarm'}}">{{boost.name}} <i class="fa-solid fa-xmark"></i></a>
    {{/each}}
    {{#each nextAttack as |p|}}
    <span class="sac-chip pending-chip">{{p.label}}{{#if p.text}} <small>{{p.text}}</small>{{/if}}</span>
    {{/each}}
  </div>
  {{/if}}

  {{#each abilityGroups as |group key|}}
  <div class="ability-group" data-group="{{key}}">
    <h3>{{localize group.label}}{{#if group.items.length}} <span class="count">{{group.items.length}}</span>{{/if}}</h3>
    <ol class="ability-list">
      {{#each group.items as |ability|}}
      <li class="ability-card {{#if ability.expanded}}expanded{{/if}} {{#if ability.armed}}armed{{/if}} draggable" data-item-id="{{ability.id}}">
        <div class="ability-row" {{#if ability.rangeValue}}data-range="{{ability.rangeValue}}"{{/if}}>
          {{!-- The icon is the roll button: click to use, hover shows the d20 overlay + preview
               tooltip. `draggable=false` lets a drag fall through to the card's item-drag (for the
               hotbar), instead of the browser dragging the anchor as a bare link. A boost isn't
               rolled — clicking arms/disarms it (the overlay shows a bolt instead of the d20). --}}
          <a class="ability-use" data-action="useAbility" draggable="false"
             {{#if ability.isBoost}}title="{{localize 'SACADIA.Boost.Toggle'}}"
             {{else if ability.rollTip}}data-tooltip-html="{{ability.rollTip}}" data-tooltip-direction="UP"{{else}}title="{{localize 'SACADIA.Ability.Use'}}"{{/if}}>
            <img class="ability-img" src="{{ability.img}}" width="48" height="48" draggable="false"/>
            {{#if ability.apCost}}<span class="ap-badge" title="{{localize 'SACADIA.Ability.ApCost'}}">{{ability.apCost}}<i class="fa-solid fa-bolt"></i></span>{{/if}}
            <span class="use-overlay"><i class="fa-solid {{#if ability.isBoost}}fa-bolt{{else}}fa-dice-d20{{/if}}"></i></span>
          </a>
          <div class="ability-main">
            <a class="ability-name" data-action="toggleExpand" draggable="false">{{ability.name}}</a>
            {{!-- What kind of action it is (a word, not a box), what it costs (the one boxed thing: a resource you spend),
                 then the facts with their glyphs. A passive shows the start of its text instead. --}}
            <div class="ability-meta">
              {{#if ability.armed}}<span class="sac-chip armed"><i class="fa-solid fa-bolt"></i> {{localize 'SACADIA.Boost.Armed'}}</span>{{/if}}
              {{#if ability.tagLabel}}<span class="meta-tag">{{localize ability.tagLabel}}</span>{{/if}}
              {{#if ability.poolText}}<span class="sac-chip pool">{{ability.poolText}}</span>{{/if}}
              {{#if ability.loreText}}<span class="sac-chip pool">{{ability.loreText}}</span>{{/if}}
              {{#each ability.madBadges as |badge|}}<span class="sac-chip mad">{{badge}}</span>{{/each}}
              {{#if ability.attackText}}<span class="meta-fact" title="{{ability.attackLong}}"><i class="fa-solid fa-crosshairs"></i> {{ability.attackText}}</span>{{/if}}
              {{#if ability.hasSave}}<span class="meta-fact"><i class="fa-solid fa-shield-halved"></i> {{localize 'SACADIA.Activity.Save'}}</span>{{/if}}
              {{#if ability.rangeText}}<span class="meta-fact"><i class="fa-solid fa-ruler"></i> {{ability.rangeText}}</span>{{/if}}
              {{#if ability.weaponName}}<span class="meta-fact" title="{{localize 'SACADIA.Ability.Weapon'}}"><i class="fa-solid fa-hand-fist"></i> {{ability.weaponName}}</span>{{/if}}
              {{#each ability.picks as |p|}}<label class="meta-fact meta-pick{{#unless p.value}} unset{{/unless}}" data-tooltip="{{p.hint}}"><i class="fa-solid {{#if p.weapon}}fa-star{{else}}fa-thumbtack{{/if}}"></i>{{#if p.label}}<span class="pick-label">{{p.label}}</span>{{/if}}<select class="ability-pick" data-slot="{{p.slot}}">{{selectOptions p.choices selected=p.value}}</select></label>{{/each}}
              {{#if ability.rangeValue}}<span class="out-of-range" hidden>{{localize 'SACADIA.Range.OutOfRangeShort'}}</span>{{/if}}
            </div>
            {{#if ability.summary}}<div class="ability-summary">{{ability.summary}}</div>{{/if}}
          </div>
          <div class="ability-controls">
            <a data-action="viewDoc" title="{{localize 'DOCUMENT.Update' type='Item'}}"><i class="fa-solid fa-edit"></i></a>
            <a data-action="deleteDoc" title="{{localize 'DOCUMENT.Delete' type='Item'}}"><i class="fa-solid fa-trash"></i></a>
          </div>
        </div>
        {{#if ability.expanded}}
        <div class="ability-drawer">{{{ability.enrichedDescription}}}</div>
        {{/if}}
      </li>
      {{else}}
      <li class="ability-empty">{{localize 'SACADIA.Ability.Empty'}}</li>
      {{/each}}
    </ol>
  </div>
  {{/each}}

  {{!-- CSP is a progression budget, referenced far less often than the live combat state — parked
       at the tab's foot rather than crowding the top. --}}
  {{#if isCharacter}}
  <div class="csp-footer">
    <label>{{localize 'SACADIA.Progression.Csp'}}</label>
    <span class="csp-values"><b>{{system.csp.current}}</b> / {{system.csp.max}} <small>({{localize 'SACADIA.Progression.CspSpent'}}: {{system.csp.spent}})</small></span>
  </div>
  {{/if}}

</section>
