<section class="tab {{tabs.abilities.cssClass}}" data-group="primary" data-tab="abilities">

  <div class="abilities-top">
    {{#if isCharacter}}
    <div class="csp-readout">
      <label>{{localize 'SACADIA.Progression.Csp'}}</label>
      <span class="csp-values">
        <b>{{system.csp.current}}</b> / {{system.csp.max}}
        <small>({{localize 'SACADIA.Progression.CspSpent'}}: {{system.csp.spent}})</small>
      </span>
    </div>
    {{/if}}
    <a class="add-ability" data-action="createDoc" data-document-class="Item" data-type="ability">
      <i class="fa-solid fa-plus"></i> {{localize 'TYPES.Item.ability'}}
    </a>
  </div>

  {{!-- Action economy: AP tally, basic-action palette, and the per-turn "Actions Used" log.
       Shared by both actor types; a character's Max AP is derived, an NPC's is editable here. --}}
  <div class="action-economy">
    <div class="ap-readout" title="{{localize 'SACADIA.Economy.ApHint'}}">
      <i class="fa-solid fa-bolt"></i>
      <label>{{localize 'SACADIA.Economy.Ap'}}</label>
      {{#if isCharacter}}
      <span class="ap-values"><b>{{system.ap.value}}</b> / {{system.ap.max}}</span>
      {{else}}
      <span class="ap-values"><b>{{system.ap.value}}</b> / <input class="ap-max" type="number" name="system.ap.max" value="{{system.ap.max}}" min="0"/></span>
      {{/if}}
      <a class="reset-turn" data-action="resetTurn" title="{{localize 'SACADIA.Economy.ResetTurn'}}">
        <i class="fa-solid fa-rotate-left"></i>
      </a>
    </div>

    {{#if classPools.length}}
    <div class="class-pools">
      {{#each classPools as |pool|}}
      <label class="class-pool" title="{{localize pool.label}}">
        <span>{{localize pool.label}}</span>
        <input type="number" name="system.classPools.{{pool.key}}.value" value="{{pool.value}}" min="0"/>
        <span>/</span>
        <input type="number" name="system.classPools.{{pool.key}}.max" value="{{pool.max}}" min="0"/>
      </label>
      {{/each}}
    </div>
    {{/if}}

    {{#if isSentinel}}
    <label class="favored-enemies" title="{{localize 'SACADIA.FavoredEnemies'}}">
      <span>{{localize 'SACADIA.FavoredEnemies'}}</span>
      <select name="system.professionResources.sentinel.favored" multiple>
        {{selectOptions config.creatureTypes selected=system.professionResources.sentinel.favored localize=true}}
      </select>
    </label>
    {{/if}}

    <div class="basic-actions">
      {{#each config.basicActions as |preset key|}}
      <a class="basic-action" data-action="logBasicAction" data-basic="{{key}}">
        {{localize preset.label}}{{#if preset.ap}} <small>{{preset.ap}}<i class="fa-solid fa-bolt"></i></small>{{/if}}
      </a>
      {{/each}}
    </div>

    <div class="action-log">
      <label>{{localize 'SACADIA.Economy.ActionsUsed'}}</label>
      <ol class="log-list">
        {{#each system.actionLog as |entry idx|}}
        <li class="log-entry">
          <span class="log-label">{{entry.label}}</span>
          <span class="log-ap">{{entry.ap}}<i class="fa-solid fa-bolt"></i></span>
          <a data-action="undoAction" data-index="{{idx}}" title="{{localize 'SACADIA.Economy.Undo'}}"><i class="fa-solid fa-arrow-rotate-left"></i></a>
        </li>
        {{else}}
        <li class="log-empty">{{localize 'SACADIA.Economy.NoActions'}}</li>
        {{/each}}
      </ol>
    </div>
  </div>

  {{!-- Combat live-state strip: the auto-maintained state the modifiers read, surfaced. Counters,
       focus streaks, and marks appear only when live; exhaustion chips are always-on toggles. --}}
  <div class="combat-strip">
    {{#if combatStrip.hasLive}}
    <div class="cs-group">
      <span class="sac-label">{{localize 'SACADIA.Combat.ThisTurn'}}</span>
      <div class="cs-counter"><span>{{localize 'SACADIA.Combat.Moved'}}</span><b>{{combatStrip.moved}} {{localize 'SACADIA.Range.Feet'}}</b></div>
      <div class="cs-counter"><span>{{localize 'SACADIA.Combat.ConsecutiveHits'}}</span><b>&times;{{combatStrip.consecutiveHits}}</b></div>
      <div class="cs-counter"><span>{{localize 'SACADIA.Combat.Attacks'}}</span><b>{{combatStrip.attacks}}</b></div>
    </div>
    {{/if}}

    <div class="cs-group">
      <span class="sac-label">{{localize 'SACADIA.Combat.Exhaustion'}}</span>
      <div class="limb-grid">
        {{#each combatStrip.exhaustion as |slot|}}
        <label class="limb {{#if slot.spent}}spent{{/if}}" title="{{localize slot.label}}">
          <input type="checkbox" name="system.exhaustion.{{slot.key}}" {{checked slot.spent}}/>
          <span>{{localize slot.label}}</span>
        </label>
        {{/each}}
      </div>
    </div>

    {{#if combatStrip.hasFocus}}
    <div class="cs-group">
      <span class="sac-label">{{localize 'SACADIA.Combat.Focus'}}</span>
      {{#each combatStrip.focus as |f|}}
      <div class="cs-line">
        <span class="cs-name">{{f.name}}</span>
        <span class="sac-streak">{{#each f.bars}}<i></i>{{/each}}</span>
        <span class="cs-detail">{{f.rounds}}</span>
      </div>
      {{/each}}
      {{#each combatStrip.marks as |m|}}
      <div class="cs-line"><span class="cs-name">{{m.key}}</span><span class="cs-detail">&rarr; {{m.names}}</span></div>
      {{/each}}
    </div>
    {{/if}}

    {{#if combatStrip.grants.length}}
    <div class="cs-group">
      <span class="sac-label">{{localize 'SACADIA.Combat.Grants'}}</span>
      {{#each combatStrip.grants as |g|}}
      <div class="cs-line"><span class="cs-name">{{g.name}}</span><span class="cs-detail">{{g.expiry}}</span></div>
      {{/each}}
    </div>
    {{/if}}
  </div>

  {{#each abilityGroups as |group key|}}
  <div class="ability-group">
    <h3>{{localize group.label}}</h3>
    <ol class="ability-list">
      {{#each group.items as |ability|}}
      <li class="ability-card {{#if ability.expanded}}expanded{{/if}} draggable" data-item-id="{{ability.id}}">
        <div class="ability-row" {{#if ability.rangeValue}}data-range="{{ability.rangeValue}}"{{/if}}>
          <img class="ability-img" src="{{ability.img}}" width="40" height="40"/>
          <div class="ability-main">
            <a class="ability-name" data-action="toggleExpand">{{ability.name}}</a>
            <div class="ability-meta">
              {{#if ability.tagLabel}}<span class="sac-chip tag">{{localize ability.tagLabel}}</span>{{/if}}
              {{#if ability.apCost}}<span class="sac-chip ap" title="{{localize 'SACADIA.Ability.ApCost'}}">{{ability.apCost}} AP</span>{{/if}}
              {{#if ability.poolText}}<span class="sac-chip pool">{{ability.poolText}}</span>{{/if}}
              {{#if ability.cspCost}}<span class="sac-chip warn" title="{{localize 'SACADIA.Ability.CspCost'}}">{{ability.cspCost}} CSP</span>{{/if}}
              {{#each ability.madBadges as |badge|}}<span class="sac-chip mad">{{badge}}</span>{{/each}}
              {{#if ability.attackText}}<span class="sac-chip">{{ability.attackText}}</span>{{/if}}
              {{#if ability.hasSave}}<span class="sac-chip">{{localize 'SACADIA.Activity.Save'}}</span>{{/if}}
              {{#if ability.rangeText}}<span class="sac-chip">{{ability.rangeText}}</span>{{/if}}
              {{#if ability.weaponName}}<span class="sac-chip" title="{{localize 'SACADIA.Ability.Weapon'}}"><i class="fa-solid fa-hand-fist"></i> {{ability.weaponName}}</span>{{/if}}
              {{#if ability.rangeValue}}<span class="out-of-range" hidden>{{localize 'SACADIA.Range.OutOfRangeShort'}}</span>{{/if}}
            </div>
          </div>
          <div class="ability-controls">
            <a class="use-btn" data-action="useAbility" title="{{localize 'SACADIA.Ability.Use'}}"><i class="fa-solid fa-dice-d20"></i></a>
            <a data-action="viewDoc" title="{{localize 'DOCUMENT.Update' type='Item'}}"><i class="fa-solid fa-edit"></i></a>
            <a data-action="deleteDoc" title="{{localize 'DOCUMENT.Delete' type='Item'}}"><i class="fa-solid fa-trash"></i></a>
          </div>
        </div>
        {{#if ability.expanded}}
        <div class="ability-drawer">{{{ability.enrichedDescription}}}</div>
        {{/if}}
      </li>
      {{else}}
      <li class="ability-empty">{{localize 'SACADIA.Ability.Empty'}}</li>
      {{/each}}
    </ol>
  </div>
  {{/each}}

</section>
