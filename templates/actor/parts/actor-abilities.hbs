<section class="tab {{tabs.abilities.cssClass}}" data-group="primary" data-tab="abilities">
  <div class="csp-readout">
    <h3>{{localize 'SACADIA.Progression.Csp'}}</h3>
    <div class="csp-values">
      <span title="{{localize 'SACADIA.Progression.CspCurrent'}}">{{system.csp.current}}</span>
      <span class="sep">/</span>
      <span title="{{localize 'SACADIA.Progression.CspMax'}}">{{system.csp.max}}</span>
      <small>({{localize 'SACADIA.Progression.CspSpent'}}: {{system.csp.spent}})</small>
    </div>
  </div>

  <p class="placeholder">{{localize 'SACADIA.Placeholder.Abilities'}}</p>
</section>
