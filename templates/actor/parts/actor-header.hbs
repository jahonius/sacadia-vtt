<header class="sheet-header">
  <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-field="img"
       title="{{actor.name}}" height="100" width="100"/>

  <div class="header-fields">
    <div class="name-row">
      <input class="charname" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'Name'}}"/>
      {{#if isCharacter}}
      <div class="rest-controls">
        <a data-action="shortRest" title="{{localize 'SACADIA.Rest.ShortHint'}}"><i class="fa-solid fa-mug-hot"></i> {{localize 'SACADIA.Rest.Short'}}</a>
        <a data-action="longRest" title="{{localize 'SACADIA.Rest.LongHint'}}"><i class="fa-solid fa-bed"></i> {{localize 'SACADIA.Rest.Long'}}</a>
      </div>
      {{/if}}
      {{!-- NPC quick-build lives in the always-visible header so it's clearly available. --}}
      {{#unless isCharacter}}
      <div class="npc-controls">
        <a data-action="pasteStatBlock" title="{{localize 'SACADIA.StatBlock.Hint'}}"><i class="fa-solid fa-paste"></i> {{localize 'SACADIA.StatBlock.Button'}}</a>
      </div>
      {{/unless}}
    </div>
    {{#if staleItems.length}}
    <div class="refresh-notice" data-tooltip="{{staleList}}">
      <i class="fa-solid fa-rotate"></i> {{localize 'SACADIA.Refresh.Notice' n=staleItems.length}}
      <a data-action="refreshItems">{{localize 'SACADIA.Refresh.Button'}}</a>
    </div>
    {{/if}}

    {{#if isCharacter}}
    <div class="profession-row">
      <label class="field">
        <span>{{localize 'SACADIA.Header.Primary'}}</span>
        <select name="system.professions.primary.key">
          {{selectOptions config.professions selected=system.professions.primary.key localize=true blank=""}}
        </select>
        <input type="number" name="system.professions.primary.level" value="{{system.professions.primary.level}}"
               min="0" title="{{localize 'SACADIA.Header.Level'}}"/>
      </label>
      <label class="field">
        <span>{{localize 'SACADIA.Header.Secondary'}}</span>
        <select name="system.professions.secondary.key">
          {{selectOptions config.professions selected=system.professions.secondary.key localize=true blank=""}}
        </select>
        <input type="number" name="system.professions.secondary.level" value="{{system.professions.secondary.level}}"
               min="0" title="{{localize 'SACADIA.Header.Level'}}"/>
      </label>
      <label class="field level-field">
        <span>{{localize 'SACADIA.Header.Level'}}</span>
        <input type="number" name="system.level" value="{{system.level}}" min="1"/>
      </label>
    </div>
    {{else}}
    <div class="profession-row">
      <label class="field">
        <span>{{localize 'SACADIA.Npc.Role'}}</span>
        <input type="text" name="system.role" value="{{system.role}}" placeholder="—"/>
      </label>
      <label class="field">
        <span>{{localize 'SACADIA.Npc.CreatureType'}}</span>
        <select name="system.creatureType">
          {{selectOptions config.creatureTypes selected=system.creatureType localize=true blank=""}}
        </select>
      </label>
      <label class="field level-field">
        <span>{{localize 'SACADIA.Npc.Cr'}}</span>
        <input type="number" name="system.cr" value="{{system.cr}}" min="0"/>
      </label>
      <label class="field level-field" data-tooltip="{{localize 'SACADIA.Speed.Hint'}}">
        <span>{{localize 'SACADIA.Speed.Label'}}</span>
        <input type="number" name="system.speed" value="{{system.speed.base}}" min="0" step="5"/>
      </label>
    </div>
    {{/if}}

    {{!-- Vital + derived stat readouts: two clusters (vitals left, derived chips right) that wrap
         as units, so a narrow window never scatters singles across a ragged row. --}}
    <div class="header-stats">
      <div class="vitals-cluster">
        <div class="vital hp-vital">
          <label class="sac-label">{{localize 'SACADIA.Resource.Health'}}</label>
          <div class="hp-readout">
            <input type="number" class="hp-cur" name="system.health.value" value="{{system.health.value}}" aria-label="{{localize 'SACADIA.Resource.Health'}}"/>
            <span class="sep">/</span>
            {{#if isCharacter}}
            <span class="hp-max" data-tooltip-html="{{hpTip}}">{{system.health.max}}</span>
            <span class="hp-adj" title="{{localize 'SACADIA.Resource.HealthAdjustHint'}}">
              <span class="hp-adj-sign">±</span>
              <input type="number" class="hp-bonus" name="system.health.bonus" value="{{system.health.bonus}}" placeholder="0"/>
            </span>
            {{else}}
            <input type="number" class="hp-cur hp-maxin" name="system.health.max" value="{{system.health.max}}"/>
            {{/if}}
            {{#if system.health.temp}}<span class="hp-temp" data-tooltip="{{localize 'SACADIA.Resource.TempHpHint'}}">+{{system.health.temp}}</span>{{/if}}
          </div>
          <div class="sac-meter hp-meter" title="{{system.health.value}} / {{system.health.max}}">
            <div class="fill" style="width: {{hpPct}}%"></div>
          </div>
        </div>

        {{#if isCharacter}}
        <div class="vital">
          <label class="sac-label">{{localize 'SACADIA.Economy.Ap'}}</label>
          {{#if apPips}}
          <div class="sac-pips" title="{{apText}}">{{#each apPips as |pip|}}<span class="sac-pip {{#if pip.on}}on{{/if}}"></span>{{/each}}</div>
          {{else}}
          <span class="vital-num">{{apText}}</span>
          {{/if}}
        </div>

        <div class="vital">
          <label class="sac-label">{{localize 'SACADIA.Economy.Reaction'}}</label>
          {{#if reactionPips}}
          <div class="sac-pips reaction-pips" title="{{reactionText}}">{{#each reactionPips as |pip|}}<span class="sac-pip {{#if pip.on}}on{{/if}}"></span>{{/each}}</div>
          {{else}}
          <span class="vital-num">{{reactionText}}</span>
          {{/if}}
        </div>

        {{#if showMadness}}
        <div class="vital">
          <label class="sac-label">{{localize 'SACADIA.Condition.Madness'}}</label>
          <div class="madness-track">
            <div class="sac-pips">{{#each madnessPips as |pip|}}<span class="sac-pip mad {{#if pip.on}}on{{/if}} {{#if pip.threshold}}threshold{{/if}}"></span>{{/each}}</div>
            {{#if insane}}<span class="insane-note">{{localize 'SACADIA.Insane.Badge'}}</span>{{/if}}
          </div>
        </div>
        {{/if}}
        {{/if}}
      </div>

      {{#if isCharacter}}
      <div class="derived-cluster">
        <div class="derived"><label>{{localize 'SACADIA.Progression.Proficiency'}}</label><span>{{system.proficiency}}</span></div>
        <div class="derived"><label>{{localize 'SACADIA.Defense.CheckDC'}}</label><span>{{system.checkDc.primary}}</span></div>
        <div class="derived speed" data-tooltip="{{localize 'SACADIA.Speed.Hint'}}"><label>{{localize 'SACADIA.Speed.Label'}}</label><span>{{system.speed.value}}ft{{#if system.speed.fly}} · {{localize 'SACADIA.Speed.Fly'}} {{system.speed.fly}}ft{{/if}}</span></div>
        {{#if system.lorePoints.max}}
        <div class="derived lore"><label>{{localize 'SACADIA.Resource.LorePoints'}}</label>
          <span><input type="number" name="system.lorePoints.value" value="{{system.lorePoints.value}}" min="0"/>/{{system.lorePoints.max}}</span>
        </div>
        {{/if}}
      </div>
      {{/if}}
    </div>

    {{!-- Defenses. Characters derive them (read-only); NPCs are hand-authored stat blocks (editable). --}}
    <div class="defenses">
      {{#each system.defenses as |def key|}}
      <div class="defense {{#if def.supersededByAd}}superseded{{/if}} {{#if def.cappedStat}}capped{{/if}}"
           {{#if @root.isCharacter}}data-tooltip-html="{{lookup @root.defTooltips key}}"{{else}}title="{{def.label}}{{#if def.supersededByAd}} — {{localize 'SACADIA.Defense.AD'}}{{/if}}{{#if def.cappedStat}} — {{localize 'SACADIA.Armor.MaxStat'}}{{/if}}"{{/if}}>
        <label>{{def.label}}</label>
        {{#if @root.isCharacter}}
        <span>{{def.value}}{{#if def.cappedStat}}<sup>*</sup>{{/if}}{{#if def.supersededByAd}}<sup class="ad-mark" title="{{localize 'SACADIA.Defense.TipSuperseded'}}">{{localize 'SACADIA.Defense.ADShort'}}</sup>{{/if}}</span>
        {{else}}
        <input type="number" class="def-input" name="system.defenses.{{key}}" value="{{def.base}}" min="0"
               title="{{#if def.supersededByAd}}{{localize 'SACADIA.Defense.AD'}} {{/if}}{{def.value}}"/>
        {{/if}}
      </div>
      {{/each}}
      {{!-- NPCs author a flat Check DC (targets roll against it to resist this monster's
           conditions / saves); characters derive it per profession. --}}
      {{#unless isCharacter}}
      <div class="defense check-dc" title="{{localize 'SACADIA.Defense.CheckDC'}}">
        <label>{{localize 'SACADIA.Defense.CheckDCShort'}}</label>
        <input type="number" class="def-input" name="system.checkDc" value="{{system.checkDc}}" min="0"/>
      </div>
      {{/unless}}
    </div>
    {{!-- Typed damage resistances (book p.222): "physical 2, fire 5, rot immune" — negative is a vulnerability. --}}
    <label class="field resistances-field" data-tooltip="{{localize 'SACADIA.Resist.TypedHint'}}">
      <span>{{localize 'SACADIA.Resist.Typed'}}</span>
      <input type="text" name="system.resistances" value="{{system.resistances}}" placeholder="physical 2, fire 5"/>
    </label>
    <label class="field size-field" data-tooltip="{{localize 'SACADIA.Size.Hint'}}">
      <span>{{localize 'SACADIA.Size.Label'}}</span>
      <select name="system.size">{{selectOptions config.sizes selected=system.size localize=true}}</select>
    </label>
  </div>
</header>
