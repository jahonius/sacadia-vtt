<header class="sheet-header {{#if isCharacter}}pc{{else}}npc{{/if}}">
  {{!-- The frame takes the header's height and the portrait covers it, so the picture fills the space without making
       the header taller. --}}
  <div class="portrait">
    <img class="profile-img" src="{{actor.img}}" data-action="editImage" data-field="img"
         title="{{actor.name}}" alt="{{actor.name}}"/>
  </div>

  <div class="header-fields">
    <div class="name-row">
      <input class="charname" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'Name'}}"/>
      {{#if isCharacter}}
      <div class="rest-controls">
        <a class="primary" data-action="rollInitiative" title="{{localize 'SACADIA.Initiative.Hint'}}"><i class="fa-solid fa-dice-d20"></i> {{localize 'SACADIA.Initiative.Roll'}}</a>
        {{!-- The book's three rests (p.235): a Quick Rest, a Fitful Rest (a night), a Long Rest (weeks of downtime). --}}
        <span class="rest-group" role="group" aria-label="{{localize 'SACADIA.Rest.Group'}}">
          <a data-action="shortRest" data-tooltip="{{localize 'SACADIA.Rest.ShortHint'}}"><i class="fa-solid fa-mug-hot"></i> {{localize 'SACADIA.Rest.ShortBtn'}}</a>
          <a data-action="fitfulRest" data-tooltip="{{localize 'SACADIA.Rest.FitfulHint'}}"><i class="fa-solid fa-bed"></i> {{localize 'SACADIA.Rest.FitfulBtn'}}</a>
          <a data-action="longRest" data-tooltip="{{localize 'SACADIA.Rest.LongHint'}}"><i class="fa-solid fa-campground"></i> {{localize 'SACADIA.Rest.LongBtn'}}</a>
        </span>
      </div>
      {{/if}}
      {{!-- NPC quick-build lives in the always-visible header so it's clearly available. --}}
      {{#unless isCharacter}}
      <div class="npc-controls">
        <a class="primary" data-action="rollInitiative" title="{{localize 'SACADIA.Initiative.Hint'}}"><i class="fa-solid fa-dice-d20"></i> {{localize 'SACADIA.Initiative.Roll'}}</a>
        <a data-action="pasteStatBlock" title="{{localize 'SACADIA.StatBlock.Hint'}}"><i class="fa-solid fa-paste"></i> {{localize 'SACADIA.StatBlock.Button'}}</a>
      </div>
      {{/unless}}
    </div>

    {{!-- A character's build (professions, level, size, resistances) is set on the Character tab; the header
         only summarizes it, so play-time readouts get the room. --}}
    {{#if isCharacter}}
    <div class="identity-line">
      {{#each identity as |p|}}{{#unless @first}}<span class="id-sep" aria-hidden="true">◆</span>{{/unless}}<span class="id-part{{#if p.quiet}} quiet{{/if}}">{{p.label}}{{#if p.n}} <b>{{p.n}}</b>{{/if}}</span>{{/each}}
    </div>
    {{else}}
    <div class="npc-row">
      <label class="sac-field">
        <span class="sac-label">{{localize 'SACADIA.Npc.Role'}}</span>
        <input type="text" name="system.role" value="{{system.role}}" placeholder="—"/>
      </label>
      <label class="sac-field">
        <span class="sac-label">{{localize 'SACADIA.Npc.CreatureType'}}</span>
        <select name="system.creatureType">
          {{selectOptions config.creatureTypes selected=system.creatureType localize=true blank=""}}
        </select>
      </label>
      <label class="sac-field narrow">
        <span class="sac-label">{{localize 'SACADIA.Npc.Cr'}}</span>
        <input type="number" name="system.cr" value="{{system.cr}}" min="0"/>
      </label>
      <label class="sac-field narrow" data-tooltip="{{localize 'SACADIA.Speed.Hint'}}">
        <span class="sac-label">{{localize 'SACADIA.Speed.Label'}}</span>
        <input type="number" name="system.speed" value="{{system.speed.base}}" min="0" step="5"/>
      </label>
      <label class="sac-field size" data-tooltip="{{localize 'SACADIA.Size.Hint'}}">
        <span class="sac-label">{{localize 'SACADIA.Size.Label'}}</span>
        <select name="system.size">{{selectOptions config.sizes selected=system.size localize=true}}</select>
      </label>
    </div>
    {{/if}}

    {{#if staleItems.length}}
    <div class="refresh-notice" data-tooltip="{{staleList}}">
      <i class="fa-solid fa-rotate"></i> {{localize 'SACADIA.Refresh.Notice' n=staleItems.length}}
      <a data-action="refreshItems">{{localize 'SACADIA.Refresh.Button'}}</a>
    </div>
    {{/if}}

    {{!-- Vitals: HP (number + bar, and Madness when it's in play) over the defense plate; AP, reactions and Lore over
         the ledger, in the same columns. --}}
    <div class="vitals">
      <div class="vital hp-vital">
        <div class="hp-readout">
          <span class="sac-label">{{localize 'SACADIA.Resource.Health'}}</span>
          <input type="number" class="hp-cur ghost" name="system.health.value" value="{{system.health.value}}" aria-label="{{localize 'SACADIA.Resource.Health'}}"/>
          <span class="sep">/</span>
          {{#if isCharacter}}
          <span class="hp-max" data-tooltip-html="{{hpTip}}">{{system.health.max}}</span>
          {{else}}
          <input type="number" class="hp-max ghost" name="system.health.max" value="{{system.health.max}}" aria-label="{{localize 'SACADIA.Resource.MaxHealth'}}"/>
          {{/if}}
          {{#if system.health.temp}}<span class="hp-temp" data-tooltip="{{localize 'SACADIA.Resource.TempHpHint'}}">+{{system.health.temp}} {{localize 'SACADIA.Resource.TempHp'}}</span>{{/if}}
          {{!-- Madness is a state like Health, so it shares Health's line (when it's in play). --}}
          {{#if showMadness}}
          <span class="madness-track" data-tooltip="{{localize 'SACADIA.Condition.Madness'}}">
            <i class="fa-solid fa-brain" aria-label="{{localize 'SACADIA.Condition.Madness'}}"></i>
            <span class="sac-pips">{{#each madnessPips as |pip|}}<span class="sac-pip mad {{#if pip.on}}on{{/if}} {{#if pip.threshold}}threshold{{/if}}"></span>{{/each}}</span>
            {{#if insane}}<span class="insane-note">{{localize 'SACADIA.Insane.Badge'}}</span>{{/if}}
          </span>
          {{/if}}
        </div>
        <div class="sac-meter hp-meter {{hpState}}" title="{{system.health.value}} / {{system.health.max}}">
          <div class="fill" style="width: {{hpPct}}%"></div>
        </div>
      </div>

      {{#if isCharacter}}
      <div class="side-vitals">
      <div class="vital">
        <span class="sac-label">{{localize 'SACADIA.Economy.Ap'}}</span>
        {{#if apPips}}
        <div class="sac-pips ap-pips" title="{{apText}}">{{#each apPips as |pip|}}<i class="fa-solid fa-bolt ap-pip {{#if pip.on}}on{{/if}}"></i>{{/each}}</div>
        {{else}}
        <span class="vital-num">{{apText}}</span>
        {{/if}}
      </div>

      <div class="vital">
        <span class="sac-label">{{localize 'SACADIA.Economy.Reaction'}}</span>
        {{#if reactionPips}}
        <div class="sac-pips reaction-pips" title="{{reactionText}}">{{#each reactionPips as |pip|}}<span class="sac-pip {{#if pip.on}}on{{/if}}"></span>{{/each}}</div>
        {{else}}
        <span class="vital-num">{{reactionText}}</span>
        {{/if}}
      </div>

      {{#if system.lorePoints.max}}
      <div class="vital lore" data-tooltip="{{localize 'SACADIA.Resource.LorePoints'}}">
        <span class="sac-label">{{localize 'SACADIA.Resource.LorePoints'}}</span>
        <span class="vital-num"><input type="number" class="ghost" name="system.lorePoints.value" value="{{system.lorePoints.value}}" min="0"
          aria-label="{{localize 'SACADIA.Resource.LorePoints'}}"/><small>/{{system.lorePoints.max}}</small></span>
      </div>
      {{/if}}
      </div>
      {{/if}}
    </div>

    {{!-- Readouts: the five defenses as one plate (what attacks are rolled against), then the derived numbers as an
         open ledger. Characters derive defenses (read-only; the tooltip shows the breakdown); NPCs are hand-authored
         stat blocks (editable). --}}
    <div class="readouts">
      <div class="defense-plate">
      {{#each system.defenses as |def key|}}
      <div class="readout defense {{#if def.supersededByAd}}superseded{{/if}} {{#if def.cappedStat}}capped{{/if}}"
           {{#if @root.isCharacter}}data-tooltip-html="{{lookup @root.defTooltips key}}"{{else}}data-tooltip="{{def.label}}{{#if def.supersededByAd}} — {{localize 'SACADIA.Defense.AD'}}{{/if}}{{#if def.cappedStat}} — {{localize 'SACADIA.Armor.MaxStat'}}{{/if}}"{{/if}}>
        <span class="sac-label">{{lookup @root.defShort key}}</span>
        {{#if @root.isCharacter}}
        <span class="readout-value">{{def.value}}{{#if def.cappedStat}}<sup>*</sup>{{/if}}{{#if def.supersededByAd}}<sup class="ad-mark" title="{{localize 'SACADIA.Defense.TipSuperseded'}}">{{localize 'SACADIA.Defense.ADShort'}}</sup>{{/if}}</span>
        {{else}}
        <input type="number" class="readout-value ghost" name="system.defenses.{{key}}" value="{{def.base}}" min="0"
               aria-label="{{def.label}}"/>
        {{/if}}
      </div>
      {{/each}}
      </div>
      <div class="ledger">
      {{#if isCharacter}}
      <div class="readout" data-tooltip="{{localize 'SACADIA.Progression.Proficiency'}}">
        <span class="sac-label">{{localize 'SACADIA.Header.ProfShort'}}</span><span class="readout-value">{{system.proficiency}}</span>
      </div>
      <div class="readout" data-tooltip="{{localize 'SACADIA.Defense.CheckDC'}}">
        <span class="sac-label">{{localize 'SACADIA.Defense.CheckDCShort'}}</span><span class="readout-value">{{system.checkDc.primary}}</span>
      </div>
      <div class="readout speed" data-tooltip="{{localize 'SACADIA.Speed.Hint'}}">
        <span class="sac-label">{{localize 'SACADIA.Speed.Label'}}</span>
        <span class="readout-value">{{system.speed.value}}<small>ft</small>{{#if system.speed.fly}}<small> · {{localize 'SACADIA.Speed.Fly'}} {{system.speed.fly}}</small>{{/if}}</span>
      </div>
      {{else}}
      {{!-- NPCs author a flat Check DC (targets roll against it to resist this monster's conditions / saves). --}}
      <div class="readout check-dc" data-tooltip="{{localize 'SACADIA.Defense.CheckDC'}}">
        <span class="sac-label">{{localize 'SACADIA.Defense.CheckDCShort'}}</span>
        <input type="number" class="readout-value ghost" name="system.checkDc" value="{{system.checkDc}}" min="0"/>
      </div>
      {{/if}}
      </div>
    </div>

    {{!-- NPC typed damage resistances (book p.222); a character's are on the Character tab. --}}
    {{#unless isCharacter}}
    <label class="sac-field resistances-field" data-tooltip="{{localize 'SACADIA.Resist.TypedHint'}}">
      <span class="sac-label">{{localize 'SACADIA.Resist.Typed'}}</span>
      <input type="text" name="system.resistances" value="{{system.resistances}}" placeholder="{{localize 'SACADIA.Header.NoResistances'}}"/>
    </label>
    {{/unless}}
  </div>
</header>
