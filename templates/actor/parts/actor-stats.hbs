<section class="tab {{tabs.stats.cssClass}}" data-group="primary" data-tab="stats">

  {{!-- Core stats + rolls. Each Trait's icon is the one on its check and save cards in chat; on a character it is also
       the roll button (a d20 fades in on hover), as an ability's icon is. --}}
  <div class="stats-block">
    <h3>{{localize 'SACADIA.Header.Traits'}}</h3>
    <div class="stats-grid">
      {{#each system.stats as |stat key|}}
      <div class="stat">
        {{#if @root.isCharacter}}
        <a class="stat-use" data-action="roll" data-roll-type="stat" data-key="{{key}}" draggable="false"
           title="{{localize 'SACADIA.Roll.RollStat' label=stat.label}}">
          <img src="{{lookup @root.config.statArt key}}" width="48" height="48" alt="" draggable="false"/>
          <span class="use-overlay"><i class="fa-solid fa-dice-d20"></i></span>
        </a>
        {{else}}
        <span class="stat-use"><img src="{{lookup @root.config.statArt key}}" width="48" height="48" alt=""/></span>
        {{/if}}
        <div class="stat-body">
          {{#if @root.isCharacter}}
          <a class="stat-name rollable" data-action="roll" data-roll-type="stat" data-key="{{key}}"
             title="{{localize 'SACADIA.Roll.RollStat' label=stat.label}}">{{stat.label}}</a>
          {{else}}
          <span class="stat-name">{{stat.label}}</span>
          {{/if}}
          <input type="number" class="ghost" name="system.stats.{{key}}.value" value="{{stat.value}}" aria-label="{{stat.label}}"/>
        </div>
      </div>
      {{/each}}
    </div>
  </div>

  {{#if isCharacter}}
  {{!-- Trait Expertise: reroll-one-failed-d20 toggles, one per trait of the primary profession. --}}
  <div class="trait-expertise">
    <h3>{{localize 'SACADIA.TraitExpertise.Title'}}</h3>
    {{#if traitExpertise.length}}
    <div class="expertise-slots">
      {{#each traitExpertise as |slot|}}
      <label class="expertise-slot {{#if slot.on}}on{{/if}}"
             data-tooltip-text="{{localize 'SACADIA.TraitExpertise.Hint' trait=(localize slot.statLabel)}}">
        <input type="checkbox" name="{{slot.name}}" {{checked slot.on}}/>
        <i class="fa-solid fa-dice-d20 expertise-icon"></i>
        <span class="expertise-body">
          <span class="expertise-trait">{{localize slot.statLabel}}</span>
          <span class="expertise-sub">{{localize 'SACADIA.TraitExpertise.Reroll'}}</span>
        </span>
      </label>
      {{/each}}
    </div>
    {{else}}
    <p class="expertise-empty">{{localize 'SACADIA.TraitExpertise.NoProfession'}}</p>
    {{/if}}
  </div>
  {{/if}}

  {{#if isCharacter}}
  {{!-- Talents (29, grouped by category) --}}
  <div class="talents">
    <h3>{{localize 'SACADIA.Talent.Title'}}</h3>
    {{#each talentGroups as |group cat|}}
    <div class="talent-group">
      <h4>{{localize group.label}}</h4>
      <ul class="talent-list">
        {{#each group.talents as |talent|}}
        <li class="talent">
          <label class="prof-toggle" title="{{localize 'SACADIA.Talent.Proficient'}}">
            <input type="checkbox" name="system.talents.{{talent.key}}.proficient" {{checked talent.proficient}}/>
          </label>
          <a class="talent-name rollable" data-action="roll" data-roll-type="talent" data-key="{{talent.key}}">
            {{localize talent.label}}
          </a>
          <span class="talent-stat">{{localize (lookup @root.config.statAbbreviations talent.stat)}}</span>
        </li>
        {{/each}}
      </ul>
    </div>
    {{/each}}
    {{!-- Specialized talents (book p.146): roll as the general talent with 1X advantage per rank. --}}
    <div class="talent-group specialties">
      <h4>{{localize 'SACADIA.Talent.Specialties'}} <a data-action="addSpecialty" title="{{localize 'SACADIA.Talent.AddSpecialty'}}"><i class="fa-solid fa-plus"></i></a></h4>
      <ul class="talent-list">
        {{#each system.specialties as |sp idx|}}
        <li class="talent specialty{{#if sp.source}} granted{{/if}}" data-index="{{idx}}" {{#if sp.source}}data-tooltip="{{localize 'SACADIA.Talent.SpecialtyGranted'}}"{{/if}}>
          <input type="text" name="system.specialties.{{idx}}.name" value="{{sp.name}}" placeholder="{{localize 'SACADIA.Talent.SpecialtyName'}}"/>
          <select name="system.specialties.{{idx}}.talent">{{selectOptions @root.talentChoices selected=sp.talent localize=true blank=""}}</select>
          <input type="number" class="rank" name="system.specialties.{{idx}}.rank" value="{{sp.rank}}" min="0" max="6" title="{{localize 'SACADIA.Talent.Rank'}}"/>
          <a class="rollable" data-action="roll" data-roll-type="specialty" data-key="{{idx}}" title="{{localize 'SACADIA.Talent.RollSpecialty'}}"><i class="fa-solid fa-dice-d20"></i></a>
          <a data-action="removeSpecialty" title="{{localize 'SACADIA.Talent.RemoveSpecialty'}}"><i class="fa-solid fa-trash"></i></a>
        </li>
        {{/each}}
      </ul>
    </div>
  </div>
  {{/if}}

</section>
