<section class="tab {{tabs.inventory.cssClass}}" data-group="primary" data-tab="inventory">

  {{!-- The purse (helpers/downtime.mjs): gold and silver coins; change a gold into silver (shift: silver into a gold); a new
       character's starting gold. An item dropped on it is bought (rules/goods.mjs). --}}
  <div class="purse" data-tooltip="{{localize 'SACADIA.Money.DropToBuy'}}" data-tooltip-direction="UP">
    <i class="fa-solid fa-coins"></i><span class="sac-label">{{localize 'SACADIA.Money.Purse'}}</span>
    <label><input type="number" name="system.money.gc" value="{{system.money.gc}}" min="0" step="1"/> gc</label>
    <label><input type="number" name="system.money.sc" value="{{system.money.sc}}" min="0" step="1"/> sc</label>
    <a class="purse-change" data-action="makeChange" data-tooltip="{{localize 'SACADIA.Money.ChangeHint' rate=inventory.rate}}"><i class="fa-solid fa-right-left"></i></a>
    {{#if inventory.startingGold}}<a class="purse-start" data-action="startingGold">{{localize 'SACADIA.Money.StartingGold' n=inventory.startingGold}}</a>{{/if}}
  </div>

  {{!-- Item slots (book pp.180–181): readied (at hand in combat) and stored (in your bags); over both is Overburdened
       (half speed). --}}
  {{#if system.itemSlots}}
  <div class="item-slots {{#if system.itemSlots.overburdened}}overburdened{{/if}}">
    <span class="slot-count" data-tooltip="{{localize 'SACADIA.Inventory.RisHint'}}">
      <i class="fa-solid fa-hand"></i><span class="sac-label">{{localize 'SACADIA.Inventory.Readied'}}</span>
      <span class="slot-val"><b>{{system.itemSlots.ris.used}}</b>/{{system.itemSlots.ris.max}}</span>{{#if system.itemSlots.axehappy}} <small>(Axehappy)</small>{{/if}}
    </span>
    <span class="slot-count" data-tooltip="{{localize 'SACADIA.Inventory.SisHint'}}">
      <i class="fa-solid fa-box"></i><span class="sac-label">{{localize 'SACADIA.Inventory.Stored'}}</span>
      <span class="slot-val"><b>{{system.itemSlots.sis.used}}</b>/{{system.itemSlots.sis.max}}</span>
    </span>
    {{#if system.itemSlots.overburdened}}<span class="sac-chip warn">{{localize 'SACADIA.Inventory.Overburdened'}}</span>{{/if}}
  </div>
  {{/if}}

  {{!-- One row per item: the name on top, what it does beneath; the storage slot at the end; edit and delete on
       hover. --}}
  {{#*inline "storage"}}
  <a class="storage-toggle {{#if item.stored}}sis{{else}}ris{{/if}}" data-action="toggleStorage"
     data-tooltip="{{localize 'SACADIA.Inventory.StorageHint'}}"
     aria-label="{{#if item.stored}}{{localize 'SACADIA.Inventory.Stored'}}{{else}}{{localize 'SACADIA.Inventory.Readied'}}{{/if}}, {{localize 'SACADIA.Inventory.SlotsN' n=item.system.slots}}">
    <i class="fa-solid {{#if item.stored}}fa-box{{else}}fa-hand{{/if}}"></i> {{item.system.slots}}
  </a>
  {{/inline}}

  {{!-- Armor (incl. shields — armor that also carries a Bash weapon facet) --}}
  <div class="inv-group">
    <div class="inv-head">
      <h3>{{localize 'SACADIA.Inventory.Armor'}}</h3>
      <a data-action="createDoc" data-document-class="Item" data-type="armor" title="{{localize 'DOCUMENT.Create' type=(localize 'SACADIA.Inventory.Armor')}}">
        <i class="fa-solid fa-plus"></i>
      </a>
    </div>
    <ol class="inv-list">
      {{#each inventory.armor as |item|}}
      <li class="inv-row draggable {{#if item.system.equipped}}equipped{{/if}}" data-item-id="{{item.id}}">
        <a class="equip-toggle" data-action="toggleEquip" title="{{localize 'SACADIA.Inventory.Equip'}}">
          <i class="fa-solid {{#if item.system.equipped}}fa-shield{{else}}fa-shield-halved{{/if}}"></i>
        </a>
        <img class="inv-img" src="{{item.img}}" width="36" height="36"/>
        <div class="inv-main">
          <div class="inv-title">
            <span class="inv-name">{{item.name}}</span>
            {{#if item.rendText}}<span class="sac-chip warn" data-tooltip="{{localize 'SACADIA.Rend.Hint'}}">{{item.rendText}}</span>{{/if}}
          </div>
          <div class="inv-facts">
            {{#if item.categoryLabel}}<span class="fact-tag">{{item.categoryLabel}}</span>{{/if}}
            {{#if item.armorText}}<span>{{item.armorText}}</span>{{/if}}
            {{#if item.weaponSummary}}<span>{{item.weaponSummary}}</span>{{/if}}
            {{#if item.price}}<span class="fact-price">{{item.price}}</span>{{/if}}
          </div>
        </div>
        <div class="inv-controls">
          {{> storage item=item}}
          <span class="hover-controls">
            {{#if item.sellFor}}<a data-action="sellItem" data-tooltip="{{localize 'SACADIA.Money.SellFor' price=item.sellFor}}"><i class="fa-solid fa-coins"></i></a>{{/if}}
            <a data-action="viewDoc" title="{{localize 'DOCUMENT.Update' type='Item'}}"><i class="fa-solid fa-edit"></i></a>
            <a data-action="deleteDoc" title="{{localize 'DOCUMENT.Delete' type='Item'}}"><i class="fa-solid fa-trash"></i></a>
          </span>
        </div>
      </li>
      {{else}}
      <li class="inv-empty">{{localize 'SACADIA.Inventory.Empty'}}</li>
      {{/each}}
    </ol>
  </div>

  {{!-- Gear (weapons carry a summary line; equipping gates their `self:wielding:*` options) --}}
  <div class="inv-group">
    <div class="inv-head">
      <h3>{{localize 'SACADIA.Inventory.Gear'}}</h3>
      <a data-action="createDoc" data-document-class="Item" data-type="gear" title="{{localize 'DOCUMENT.Create' type=(localize 'SACADIA.Inventory.Gear')}}">
        <i class="fa-solid fa-plus"></i>
      </a>
    </div>
    <ol class="inv-list">
      {{#each inventory.gear as |item|}}
      <li class="inv-row draggable {{#if item.system.equipped}}equipped{{/if}} {{#if item.lit}}lit{{/if}}" data-item-id="{{item.id}}">
        <a class="equip-toggle" data-action="toggleEquip" title="{{#if item.equipHint}}{{item.equipHint}}{{else}}{{localize 'SACADIA.Inventory.Equip'}}{{/if}}">
          <i class="fa-solid fa-hand-fist"></i>
        </a>
        <img class="inv-img" src="{{item.img}}" width="36" height="36"/>
        <div class="inv-main">
          <div class="inv-title">
            <span class="inv-name">{{item.name}}</span>
            {{#if (gt item.system.quantity 1)}}<span class="inv-qty">×{{item.system.quantity}}</span>{{/if}}
            {{#if item.isSignature}}<span class="sac-chip signature" title="{{localize 'SACADIA.Inventory.SignatureHint'}}"><i class="fa-solid fa-star"></i> {{localize 'SACADIA.Inventory.Signature'}}</span>{{/if}}
            {{#if item.namedBy}}<span class="sac-chip signature" title="{{localize 'SACADIA.Inventory.NamedHint'}}"><i class="fa-solid fa-star"></i> {{item.namedBy}}</span>{{/if}}
            {{#if item.broken}}<span class="sac-chip warn">{{localize 'SACADIA.Rend.Broken'}}</span>{{/if}}
            {{#if item.lit}}<span class="sac-chip lit"><i class="fa-solid fa-fire"></i> {{localize 'SACADIA.Goods.Lit'}}</span>{{/if}}
            {{#if item.runeUnchosen}}<span class="sac-chip warn" data-tooltip="{{localize 'SACADIA.Goods.RuneChooseHint'}}">{{localize 'SACADIA.Goods.RuneChoose'}}</span>{{/if}}
          </div>
          {{#if (or item.weaponSummary item.goodsFacts item.price)}}<div class="inv-facts">{{#if item.weaponSummary}}<span>{{item.weaponSummary}}</span>{{/if}}{{#if item.goodsFacts}}<span>{{item.goodsFacts}}</span>{{/if}}{{#if item.price}}<span class="fact-price">{{item.price}}</span>{{/if}}</div>{{/if}}
        </div>
        <div class="inv-controls">
          {{#if item.lightable}}<a class="light-toggle {{#if item.lit}}on{{/if}}" data-action="toggleLight"
             data-tooltip="{{#if item.glowing}}{{localize 'SACADIA.Goods.ApplyGlow'}}{{else if item.lit}}{{localize 'SACADIA.Goods.Extinguish'}}{{else}}{{localize 'SACADIA.Goods.Illuminate'}}{{/if}}">
            <i class="fa-solid {{#if item.glowing}}fa-wand-sparkles{{else}}fa-fire{{/if}}"></i></a>{{/if}}
          {{#if item.usable}}<a class="use-goods" data-action="useGoods" data-tooltip="{{localize 'SACADIA.Goods.Use'}}"><i class="fa-solid fa-hand-holding"></i></a>{{/if}}
          {{> storage item=item}}
          <span class="hover-controls">
            {{#if item.sellFor}}<a data-action="sellItem" data-tooltip="{{localize 'SACADIA.Money.SellFor' price=item.sellFor}}"><i class="fa-solid fa-coins"></i></a>{{/if}}
            <a data-action="viewDoc" title="{{localize 'DOCUMENT.Update' type='Item'}}"><i class="fa-solid fa-edit"></i></a>
            <a data-action="deleteDoc" title="{{localize 'DOCUMENT.Delete' type='Item'}}"><i class="fa-solid fa-trash"></i></a>
          </span>
        </div>
      </li>
      {{else}}
      <li class="inv-empty">{{localize 'SACADIA.Inventory.Empty'}}</li>
      {{/each}}
    </ol>
  </div>

</section>
