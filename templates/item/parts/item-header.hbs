<header class="sheet-header">
  <img class="profile-img" src="{{item.img}}" data-action="editImage" data-field="img" title="{{item.name}}"
       height="64" width="64"/>
  <div class="header-fields">
    <input class="charname" name="name" type="text" value="{{item.name}}" placeholder="{{localize 'Name'}}"/>
    <span class="item-type">{{itemTypeLabel}}</span>
  </div>
</header>
