{
  "name": "sacadia",
  "version": "0.1.0",
  "description": "Build tooling (SCSS compiler) for the Tales of Sacadia Foundry VTT system.",
  "scripts": {
    "build": "sass src/scss/sacadia.scss css/sacadia.css --style=expanded --no-source-map",
    "watch": "sass src/scss/sacadia.scss css/sacadia.css --style=expanded --source-map --watch",
    "test": "node --test"
  },
  "browserslist": [
    "last 3 versions"
  ],
  "author": "Jon",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "sass": "^1.53.0"
  }
}
