{
  "name": "sacadia",
  "version": "0.3.2",
  "description": "Build tooling (SCSS compiler) for the Tales of Sacadia Foundry VTT system.",
  "scripts": {
    "build": "sass src/scss/sacadia.scss css/sacadia-skin.css --style=expanded --no-source-map",
    "build:packs": "node src/build-packs.mjs && node src/build-adventures.mjs",
    "watch": "sass src/scss/sacadia.scss css/sacadia-skin.css --style=expanded --source-map --watch",
    "test": "node --test",
    "test:quench": "npm --prefix tools/quench test",
    "release": "node tools/release.mjs",
    "icons": "node src/generate-icons.mjs"
  },
  "browserslist": [
    "last 3 versions"
  ],
  "author": "Jon",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "classic-level": "^3.0.0",
    "sass": "^1.53.0",
    "sharp": "^0.35.5"
  }
}
